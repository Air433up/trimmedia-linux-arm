# ============================================================
# trimmedia Docker Compose 环境配置
# 复制此文件为 .env 后按需修改
# ============================================================

# 媒体库根目录（容器内路径，通常用默认值配合 volume 即可）
MEDIA_DIR=/vol1/1000

# 飞牛影视 Web 端口
FNTV_PORT=8005

# 飞牛音乐 Web 端口
FNMUSIC_PORT=8007

# GitHub 下载代理前缀（国内用户可设置加速镜像）
# 例: PROXY_PREFIX=https://ghfast.top/
# 例: PROXY_PREFIX=https://mirror.ghproxy.com/
PROXY_PREFIX=